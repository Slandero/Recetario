<?xml version="1.0" encoding="utf-8"?>
<!-- saveEnabled=false: los renglones se crean en código y comparten ids -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <AutoCompleteTextView
        android:id="@+id/actvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:completionThreshold="1"
        android:hint="@string/ingrediente_hint"
        android:inputType="textCapSentences"
        android:saveEnabled="false"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etCantidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:hint="@string/cantidad_hint"
        android:inputType="numberDecimal"
        android:saveEnabled="false"
        android:singleLine="true" />

    <Spinner
        android:id="@+id/spUnidad"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1.4"
        android:saveEnabled="false" />

    <ImageButton
        android:id="@+id/btnQuitar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/quitar_ingrediente"
        android:src="@drawable/ic_cerrar"
        android:tint="?attr/colorTextoSecundario" />
</LinearLayout>
