<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Filtros: tipo de comida, dificultad y favoritas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_spinner_chip"
                android:paddingStart="14dp"
                android:paddingEnd="32dp"
                android:popupBackground="?attr/colorTarjeta"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/spDificultad"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_spinner_chip"
                android:paddingStart="14dp"
                android:paddingEnd="32dp"
                android:popupBackground="?attr/colorTarjeta"
                android:spinnerMode="dropdown" />

            <CheckBox
                android:id="@+id/cbFavoritas"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_favoritas"
                android:button="@null"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/solo_favoritas"
                android:textColor="@color/texto_chip_favoritas"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvConteo"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvRecetas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />

        <LinearLayout
            android:id="@+id/vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_restaurante" />

            <TextView
                android:id="@+id/tvVacio"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/fabNueva"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/nueva_receta"
            android:elevation="6dp"
            android:src="@drawable/ic_agregar"
            android:tint="@color/blanco" />
    </FrameLayout>
</LinearLayout>
