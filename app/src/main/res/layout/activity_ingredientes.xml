<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_campo_buscar"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_buscar"
        android:drawableTint="?attr/colorTextoSecundario"
        android:hint="@string/buscar_ingrediente"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvConteo"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvIngredientes"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:divider="@drawable/divisor"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvVacio"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/sin_ingredientes"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
