<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Foto de la receta o, si no tiene, la inicial con el color de su categoría -->
    <FrameLayout
        android:id="@+id/marcoFoto"
        android:layout_width="64dp"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/foto_de_receta"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/blanco"
            android:textSize="28sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategoria"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvInfo"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_reloj_chico"
            android:gravity="center_vertical" />
    </LinearLayout>

    <!-- blocksDescendants en la raíz: así el renglón se puede tocar y el corazón también -->
    <ImageButton
        android:id="@+id/btnFavorita"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:tint="?attr/colorFavorito" />
</LinearLayout>
