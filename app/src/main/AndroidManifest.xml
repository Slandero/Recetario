<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No se piden permisos: las fotos se eligen con el selector del sistema,
         la cámara escribe en un archivo de la app por medio de FotoProvider y
         los archivos exportados se guardan donde el usuario elige. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.Recetario">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetalleRecetaActivity"
            android:parentActivityName=".MainActivity" />

        <!-- configChanges: al girar o cambiar el tamaño de la pantalla no se recrea el formulario -->
        <activity
            android:name=".FormRecetaActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PlanificadorActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ListaIngredientesActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".IngredientesActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AjustesActivity"
            android:parentActivityName=".MainActivity" />

        <provider
            android:name=".util.FotoProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
